# Copy to .env for local development. In production, set these as real environment variables.

# Required. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# Defaults to False. Never True in production
DJANGO_DEBUG=True

# Comma-separated. Required when DJANGO_DEBUG is False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed to call the API
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
